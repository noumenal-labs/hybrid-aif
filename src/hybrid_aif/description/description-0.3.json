    "hybrid_aif_description": {
      "const": "0.3"
    },
    "library_version": {
      "type": "string"
    },
    "arrays_file": {
      "type": "string"
    },
    "variables": {
      "$ref": "#/$defs/body/properties/variables"
    },
    "parameters": {
      "$ref": "#/$defs/body/properties/parameters"
    },
    "factors": {
      "$ref": "#/$defs/body/properties/factors"
    },
    "relations": {
      "$ref": "#/$defs/body/properties/relations"
    },
    "clamps": {
