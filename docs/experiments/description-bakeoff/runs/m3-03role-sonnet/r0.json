{
  "hybrid_aif_description": "0.3",
  "variables": {
    "location": {"domain": "categorical", "levels": 4},
    "context": {"domain": "categorical", "levels": 2},
    "u_location": {"domain": "categorical", "levels": 4},
    "a_location": {"domain": "categorical", "levels": 4},
    "position": {"domain": "categorical", "levels": 4},
    "cue": {"domain": "categorical", "levels": 3},
    "D_location": {"domain": "logits", "shape": [4]},
    "B_location": {"domain": "log_simplex", "shape": [4, 4, 4]},
    "D_context": {"domain": "logits", "shape": [2]},
    "B_context": {"domain": "log_simplex", "shape": [2, 2]},
    "A_position": {"domain": "log_simplex", "shape": [4, 4]},
    "A_cue": {"domain": "log_simplex", "shape": [3, 4, 2]},
    "A_cue_concentration": {"domain": "positive", "shape": [3, 4, 2]},
    "K_a_location": {"domain": "log_simplex", "shape": [4, 4]},
    "H_location": {"domain": "logits", "shape": [4, 2]}
  },
  "factors": {
    "location": {
      "initial": {"family": "Categorical", "parameters": {"logits": "D_location"}},
      "transition": {
        "family": "ConditionalCategorical",
        "parents": ["location", "u_location"],
        "parameters": {"log_table": "B_location"}
      },
      "terminal": {
        "family": "ConditionalCategorical",
        "parents": ["context"],
        "parameters": {"log_table": "H_location"}
      }
    },
    "context": {
      "initial": {"family": "Categorical", "parameters": {"logits": "D_context"}},
      "transition": {
        "family": "ConditionalCategorical",
        "parents": ["context"],
        "parameters": {"log_table": "B_context"}
      }
    },
    "a_location": {
      "actuator": {
        "family": "ConditionalCategorical",
        "parents": ["u_location"],
        "parameters": {"log_table": "K_a_location"}
      }
    },
    "position": {
      "likelihood": {
        "family": "ConditionalCategorical",
        "parents": ["location"],
        "parameters": {"log_table": "A_position"}
      }
    },
    "cue": {
      "likelihood": {
        "family": "ConditionalCategorical",
        "parents": ["location", "context"],
        "parameters": {"log_table": "A_cue"}
      }
    },
    "A_cue": {
      "prior": {"family": "Dirichlet", "parameters": {"concentration": "A_cue_concentration"}}
    }
  },
  "relations": {
    "controls": {"u_location": "a_location"},
    "observed": ["position", "cue"]
  },
  "clamps": {
    "D_location": [0.0, -Infinity, -Infinity, -Infinity],
    "B_location": [
      [
        [0.0, -Infinity, -Infinity, -Infinity],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [0.0, -Infinity, -Infinity, -Infinity]
      ],
      [
        [-Infinity, 0.0, -Infinity, -Infinity],
        [0.0, 0.0, 0.0, 0.0],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [-Infinity, 0.0, -Infinity, -Infinity]
      ],
      [
        [-Infinity, -Infinity, 0.0, -Infinity],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [0.0, 0.0, 0.0, 0.0],
        [-Infinity, -Infinity, 0.0, -Infinity]
      ],
      [
        [-Infinity, -Infinity, -Infinity, 0.0],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [-Infinity, -Infinity, -Infinity, -Infinity],
        [-Infinity, -Infinity, -Infinity, 0.0]
      ]
    ],
    "D_context": 0.0,
    "B_context": [[0.0, -Infinity], [-Infinity, 0.0]],
    "A_position": [
      [0.0, -Infinity, -Infinity, -Infinity],
      [-Infinity, 0.0, -Infinity, -Infinity],
      [-Infinity, -Infinity, 0.0, -Infinity],
      [-Infinity, -Infinity, -Infinity, 0.0]
    ],
    "A_cue_concentration": 1.0,
    "K_a_location": [
      [-0.10536051565782628, -3.4011973816621555, -3.4011973816621555, -3.4011973816621555],
      [-3.4011973816621555, -0.10536051565782628, -3.4011973816621555, -3.4011973816621555],
      [-3.4011973816621555, -3.4011973816621555, -0.10536051565782628, -3.4011973816621555],
      [-3.4011973816621555, -3.4011973816621555, -3.4011973816621555, -0.10536051565782628]
    ],
    "H_location": [[0.0, 0.0], [3.0, 0.0], [0.0, 3.0], [0.0, 0.0]]
  },
  "objective": {"decomposition": "utility_infogain"},
  "configuration": {"planning": {"planner": "enumeration", "horizon": 3, "gamma": 16.0}}
}
