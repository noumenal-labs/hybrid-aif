    "rat.B_location": {"domain": "log_simplex", "shape": [4, 4, 4]},
    "rat.D_context": {"domain": "logits", "shape": [2]},
    "rat.B_context": {"domain": "log_simplex", "shape": [2, 2]},
    "rat.A_position": {"domain": "log_simplex", "shape": [4, 4]},
