  "factors": {
    "rat.location": {
      "genesis": {
        "family": "Categorical",
        "steps": "0",
        "parameters": {"logits": "rat.D_location"}
      },
      "advance": {
        "family": "ConditionalCategorical",
        "parents": ["rat.location[t-1]", "rat.u_location[t-1]"],
        "steps": "1+",
        "parameters": {"log_table": "rat.B_location"}
      }
    },
    "rat.context": {
      "genesis": {
        "family": "Categorical",
        "steps": "0",
        "parameters": {"logits": "rat.D_context"}
      },
      "persist": {
        "family": "ConditionalCategorical",
        "parents": ["rat.context[t-1]"],
        "steps": "1+",
        "parameters": {"log_table": "rat.B_context"}
      }
    },
    "rat.a_location": {
      "apply": {
        "family": "ConditionalCategorical",
        "parents": ["rat.u_location[t]"],
        "steps": "all",
        "parameters": {"log_table": "rat.K_a_location"}
      }
    },
    "rat.position": {
      "see": {
        "family": "ConditionalCategorical",
        "parents": ["maze.location[t]"],
        "steps": "all",
        "parameters": {"log_table": "rat.A_position"}
      }
    },
    "rat.cue": {
      "perceive": {
        "family": "ConditionalCategorical",
        "parents": ["rat.location[t]", "rat.context[t]"],
        "steps": "all",
        "parameters": {"log_table": "rat.A_cue"}
      }
    },
    "rat.outcome": {
      "sense": {
        "family": "ConditionalCategorical",
        "parents": ["rat.location[t]", "rat.context[t]"],
        "steps": "all",
        "parameters": {"log_table": "rat.A_outcome"}
      },
      "target": {
        "family": "Categorical",
        "parameters": {"logits": "rat.C_outcome"}
      }
    },
    "maze.location": {
      "genesis": {
        "family": "Categorical",
        "steps": "0",
        "parameters": {"logits": "maze.D_location"}
      },
      "advance": {
        "family": "ConditionalCategorical",
        "parents": ["maze.location[t-1]", "maze.door[t-1]", "rat.u_location[t-1]"],
        "steps": "1+",
        "parameters": {"log_table": "maze.B_location"}
      }
    },
    "maze.context": {
      "genesis": {
        "family": "Categorical",
        "steps": "0",
        "parameters": {"logits": "maze.D_context"}
      },
      "persist": {
        "family": "ConditionalCategorical",
        "parents": ["maze.context[t-1]"],
        "steps": "1+",
        "parameters": {"log_table": "maze.B_context"}
      }
    },
    "maze.door": {
      "genesis": {
        "family": "Categorical",
        "steps": "0",
        "parameters": {"logits": "maze.D_door"}
      },
      "maintain": {
        "family": "ConditionalCategorical",
        "parents": ["maze.door[t-1]"],
        "steps": "1+",
        "parameters": {"log_table": "maze.B_door"}
      }
    },
    "maze.position": {
      "observe": {
        "family": "ConditionalCategorical",
        "parents": ["maze.location[t]"],
        "steps": "all",
        "parameters": {"log_table": "maze.A_position"}
      }
    }
  },
  "relations": {
    "controls": {"rat.u_location": "rat.a_location"},
    "observed": ["rat.position", "rat.cue", "rat.outcome", "maze.position"]
  },
